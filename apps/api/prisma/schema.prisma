// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  image         String?
  githubId      String     @unique
  role          Role       @default(MEMBER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  agents        Agent[]
  runs          AgentRun[]
  integrations  Integration[]

  @@index([githubId])
  @@index([email])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  sessionToken String  @unique
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Agent {
  id              String     @id @default(cuid())
  userId          String
  name            String
  description     String?
  templateId      String?
  archetype       AgentArchetype @default(SLACK_RESPONDER)

  systemPrompt    String     @db.Text
  model           LLMModel   @default(SONNET_4)
  temperature     Float      @default(0.7)
  maxTokens       Int        @default(1024)

  enabled         Boolean    @default(true)
  isPublished     Boolean    @default(false)

  config          Json       // Stores integration configs, triggers, etc
  lastRun         DateTime?
  executionCount  Int        @default(0)
  successCount    Int        @default(0)
  totalCost       Float      @default(0)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        AgentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  runs            AgentRun[]
  integrations    AgentIntegration[]
  webhooks        Webhook[]

  @@index([userId])
  @@index([templateId])
  @@index([createdAt])
}

model AgentTemplate {
  id              String     @id @default(cuid())
  name            String
  description     String?
  archetype       AgentArchetype

  systemPrompt    String     @db.Text
  model           LLMModel   @default(SONNET_4)
  temperature     Float      @default(0.7)
  maxTokens       Int        @default(1024)

  configTemplate  Json

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  agents          Agent[]
}

model AgentIntegration {
  id              String     @id @default(cuid())
  agentId         String
  integrationType IntegrationType

  config          Json       // OAuth tokens, webhook URLs, etc

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  agent           Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, integrationType])
  @@index([agentId])
}

model Integration {
  id              String     @id @default(cuid())
  userId          String
  type            IntegrationType

  name            String
  config          Json       // OAuth tokens, API keys, etc

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model AgentRun {
  id              String     @id @default(cuid())
  agentId         String
  userId          String

  input           String     @db.Text
  output          String?    @db.Text
  error           String?    @db.Text

  status          ExecutionStatus @default(PENDING)

  tokenUsage      Json       // { inputTokens, outputTokens, totalTokens }
  costEstimate    Float      @default(0)
  duration        Int?       // milliseconds

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  agent           Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Webhook {
  id              String     @id @default(cuid())
  agentId         String

  url             String
  secret          String
  event           String

  active          Boolean    @default(true)
  lastTriggered   DateTime?
  failureCount    Int        @default(0)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  agent           Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

enum Role {
  ADMIN
  MEMBER
}

enum AgentArchetype {
  SLACK_RESPONDER
  GOOGLE_DRIVE_SCANNER
  WEBHOOK_LISTENER
  EMAIL_PROCESSOR
  DATA_ANALYST
}

enum LLMModel {
  OPUS_4
  SONNET_4
  HAIKU_4
}

enum IntegrationType {
  SLACK
  GOOGLE_DRIVE
  WEBHOOK
  EMAIL
  GITHUB
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}
